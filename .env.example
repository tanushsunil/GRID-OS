NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (never prefix with NEXT_PUBLIC_). Lets people sign in with their login ID instead of their email.
SUPABASE_SECRET_KEY=
# Explicitly enable isolated browser-local demo. Never enables real workspace access.
GRID_DEMO_MODE=false
# Google Drive invoice folder (optional). See README: Google Cloud OAuth client (Web) with redirect
# https://<your-site>/api/google/callback, the Drive API and Picker API enabled, scope drive.file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
# Secret for the nightly job (monthly invoices + Drive sync)
CRON_SECRET=
